# Optional external AI research. Do NOT replace your existing .env with this file.
# Copy only the settings you want to add. Keys stay on your Mac, never in Git/chat.
WEB_RESEARCH_ENABLED=0
WEB_RESEARCH_AUTO=0
OPENAI_API_KEY=
# Set an API model your account can access that supports Responses web_search.
WEB_RESEARCH_MODEL=

# Request-count limits, NOT a guaranteed monetary spending cap.
WEB_RESEARCH_DAILY_LIMIT=10
WEB_RESEARCH_HOURLY_LIMIT=2
WEB_RESEARCH_COOLDOWN_MINUTES=60
WEB_RESEARCH_MAX_TOOL_CALLS=3
WEB_RESEARCH_MAX_OUTPUT_TOKENS=3000

# After changing .env, recreate BOTH processes:
# docker compose up -d --force-recreate radar-api web-research-worker
