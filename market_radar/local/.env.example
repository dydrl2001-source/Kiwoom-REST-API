# LOCAL MARKET RADAR
POSTGRES_PASSWORD=change-this-password
DASHBOARD_TOKEN=change-this-long-random-token

# Kiwoom: first test with demo
KIWOOM_MODE=demo
# Optional account/investor read-only connector. real uses APP_KEY/APP_SECRET;
# mock uses APP_KEY_MOCK/APP_SECRET_MOCK. No order endpoints or AI account export.
MARKET_OS_READONLY_ENABLED=0
KIWOOM_POLL_SECONDS=30
KIWOOM_TRADE_VALUE_MULTIPLIER=1000000
KIWOOM_MARKET_CAP_MULTIPLIER=100000000

# Demo keys
APP_KEY_MOCK=
APP_SECRET_MOCK=

# Real keys (use only when KIWOOM_MODE=real)
APP_KEY=
APP_SECRET=

# Telegram API (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BACKFILL_DAYS=7
TELEGRAM_RECONCILE_SECONDS=600

REGIME_POLL_SECONDS=30
REGIME_STALE_SECONDS=120

# Chart / Mimosa
CHART_POLL_SECONDS=60
CHART_TOP_STOCKS=20
CHART_MINUTE_INTERVAL=3
CHART_DAILY_REFRESH_SECONDS=1800
MIMOSA_POLL_SECONDS=30
MIMOSA_INTERVAL_MIN=3

# External news fallback
NEWS_POLL_SECONDS=60
NEWS_REFRESH_MINUTES=15
NEWS_TOP_STOCKS=20

# KOSPI/KOSDAQ index charts
INDEX_CHART_POLL_SECONDS=60
INDEX_CHART_INTERVAL_MIN=5
INDEX_DAILY_REFRESH_SECONDS=1800

# Trigger-driven research queue
RESEARCH_POLL_SECONDS=30
RESEARCH_MIN_SCORE=40
RESEARCH_COOLDOWN_MINUTES=15

# OpenDART (optional but recommended)
DART_API_KEY=
DART_POLL_SECONDS=60
DART_CORP_MAP_REFRESH_HOURS=24

# Local multi-agent deep research
DEEP_RESEARCH_POLL_SECONDS=20
DEEP_RESEARCH_MIN_PRIORITY=60
DEEP_RESEARCH_LOOKBACK_HOURS=24

# Kiwoom market-theme mapping
THEME_POLL_SECONDS=60
THEME_STOCKS_PER_CYCLE=5
THEME_REFRESH_HOURS=24

# External web research (paid API, disabled by default)
OPENAI_API_KEY=
WEB_RESEARCH_MODEL=
WEB_RESEARCH_ENABLED=0
WEB_RESEARCH_AUTO=0
WEB_RESEARCH_DAILY_LIMIT=1
WEB_RESEARCH_HOURLY_LIMIT=1
WEB_RESEARCH_COOLDOWN_MINUTES=60
WEB_RESEARCH_MAX_TOOL_CALLS=3
WEB_RESEARCH_MAX_OUTPUT_TOKENS=3000

# Candidate survival history
CANDIDATE_TRACK_POLL_SECONDS=30

# Home dashboard performance
DASHBOARD_CACHE_SECONDS=20
LEADER_CALENDAR_CACHE_SECONDS=300

# Market OS shadow learning
MARKET_OS_LEARNING_POLL_SECONDS=60
# Prospective CONTROL/CHALLENGER observation only; no live rule mutation
MARKET_OS_SHADOW_LAB_ENABLED=1
# Human-started versioned CONTROL/CANDIDATE dry-run only
MARKET_OS_RULESET_DRY_RUN_ENABLED=1
# Release Candidate canary preview only; primary Market OS remains CONTROL
MARKET_OS_CANARY_ENABLED=1

# Reversible CONTROL switch — OFF by default. Prepare is allowed; commit requires this ON.
MARKET_OS_LIVE_SWITCH_ENABLED=0
MARKET_OS_SWITCH_HEALTH_SECONDS=900
MARKET_OS_SWITCH_PREPARE_TTL_SECONDS=1800

# Execution Firewall — review intents only, no broker orders. Disabled by default.
MARKET_OS_EXECUTION_INTENTS_ENABLED=0
MARKET_OS_INTENT_TTL_SECONDS=120
MARKET_OS_INTENT_COOLDOWN_MINUTES=30
MARKET_OS_INTENT_DAILY_LIMIT=12
MARKET_OS_INTENT_MAX_PENDING=3

# Kiwoom 0B realtime — observation only, disabled until live preflight is ready
KIWOOM_REALTIME_ENABLED=0
KIWOOM_REALTIME_TOP_N=30
KIWOOM_REALTIME_UNIVERSE_SECONDS=30
KIWOOM_REALTIME_FLUSH_SECONDS=2

# Paper Trading Lab — prospective rule validation only; no orders
PAPER_TRADE_POLL_SECONDS=30
PAPER_ENTRY_SCORE=70
PAPER_ENTRY_SURVIVE_SECONDS=120
PAPER_EXIT_SCORE=55
PAPER_MAX_HOLD_MINUTES=30
PAPER_MAX_OPEN=5
PAPER_QUOTE_FRESH_SECONDS=120

# Paper Lab automatic feedback — analysis only, never auto-applies thresholds
PAPER_FEEDBACK_POLL_SECONDS=60
PAPER_FEEDBACK_LOOKBACK_DAYS=30
PAPER_FEEDBACK_MIN_TYPE_SAMPLES=20
PAPER_FEEDBACK_MIN_RULE_SAMPLES=30

# Daily Decision Packet (KST 14:30 <= time < 14:40; weekdays + fresh source data)
# Packet creation is local/rules-only. Paid AI remains opt-in.
MARKET_OS_DAILY_ENABLED=1
MARKET_OS_DAILY_AI_ENABLED=0
MARKET_OS_DAILY_AI_MODEL=
# OPENAI_API_KEY above is shared. Hard global limit=1/day across ALL Radar generation.
# Failure/timeouts count; no retry. Keep WEB_RESEARCH_ENABLED/AUTO=0 to reserve the
# day's slot for this packet. Limits cannot be raised with environment variables.

# Official NAVER search: human-only, on demand. No results sent to AI or stored.
NAVER_SEARCH_ENABLED=0
NAVER_SEARCH_PROVIDER=hub
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_SEARCH_DAILY_LIMIT=100
# hub: NCP NAVER API HUB credentials. legacy: pre-2026-07-31 registrations only;
# legacy service ends 2027-07-01 KST. Do not mix the two credential types.
# Manual execution v2.4: approval alone never sends an order.
# This enables only a separately confirmed execute command, never auto execution.
MARKET_OS_LIVE_ORDERS_ENABLED=0
# Server-owned authenticated facts integration (Python module); blank blocks execution.
# Must verify account capacity, day loss, session, live quote, duplicate orders and history.
MARKET_OS_ORDER_FACTS_MODULE=
# Persistent private random secret (at least 32 chars) for opaque actual-account HMAC.
# All executors sharing this database must use the same secret; never log/export it.
MARKET_OS_ACCOUNT_BINDING_SECRET=


# End-of-day Review Bridge — separate read-only HTTP surface.
# Use a long random token; never reuse DASHBOARD_TOKEN or broker credentials.
REVIEW_BRIDGE_TOKEN=change-this-separate-long-random-token
MARKET_REVIEW_JOURNAL_POLL_SECONDS=15
# Optional JSON map, e.g. {"급등일보":["급등일보"],"MyFamily":["channel-a","channel-b"]}
REVIEW_SOURCE_FAMILY_ALIASES_JSON=
