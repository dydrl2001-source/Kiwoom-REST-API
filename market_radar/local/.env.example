# LOCAL MARKET RADAR
POSTGRES_PASSWORD=change-this-password
DASHBOARD_TOKEN=change-this-long-random-token

# Kiwoom: first test with demo
KIWOOM_MODE=demo
KIWOOM_POLL_SECONDS=30
KIWOOM_TRADE_VALUE_MULTIPLIER=1000000
KIWOOM_MARKET_CAP_MULTIPLIER=100000000

# Demo keys
APP_KEY_MOCK=
APP_SECRET_MOCK=

# Real keys (use only when KIWOOM_MODE=real)
APP_KEY=
APP_SECRET=

# Telegram API (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BACKFILL_DAYS=7
TELEGRAM_RECONCILE_SECONDS=600

REGIME_POLL_SECONDS=30
REGIME_STALE_SECONDS=120

# Chart / Mimosa
CHART_POLL_SECONDS=60
CHART_TOP_STOCKS=20
CHART_MINUTE_INTERVAL=3
CHART_DAILY_REFRESH_SECONDS=1800
MIMOSA_POLL_SECONDS=30
MIMOSA_INTERVAL_MIN=3

# External news fallback
NEWS_POLL_SECONDS=60
NEWS_REFRESH_MINUTES=15
NEWS_TOP_STOCKS=20

# KOSPI/KOSDAQ index charts
INDEX_CHART_POLL_SECONDS=60
INDEX_CHART_INTERVAL_MIN=5
INDEX_DAILY_REFRESH_SECONDS=1800

# Trigger-driven research queue
RESEARCH_POLL_SECONDS=30
RESEARCH_MIN_SCORE=40
RESEARCH_COOLDOWN_MINUTES=15

# OpenDART (optional but recommended)
DART_API_KEY=
DART_POLL_SECONDS=60
DART_CORP_MAP_REFRESH_HOURS=24

# Local multi-agent deep research
DEEP_RESEARCH_POLL_SECONDS=20
DEEP_RESEARCH_MIN_PRIORITY=60
DEEP_RESEARCH_LOOKBACK_HOURS=24

# Kiwoom market-theme mapping
THEME_POLL_SECONDS=60
THEME_STOCKS_PER_CYCLE=5
THEME_REFRESH_HOURS=24

# External web research (paid API, disabled by default)
OPENAI_API_KEY=
WEB_RESEARCH_MODEL=
WEB_RESEARCH_ENABLED=0
WEB_RESEARCH_AUTO=0
WEB_RESEARCH_DAILY_LIMIT=1
WEB_RESEARCH_HOURLY_LIMIT=1
WEB_RESEARCH_COOLDOWN_MINUTES=60
WEB_RESEARCH_MAX_TOOL_CALLS=3
WEB_RESEARCH_MAX_OUTPUT_TOKENS=3000

# Candidate survival history
CANDIDATE_TRACK_POLL_SECONDS=30

# Home dashboard performance
DASHBOARD_CACHE_SECONDS=20
LEADER_CALENDAR_CACHE_SECONDS=300

# Market OS shadow learning
MARKET_OS_LEARNING_POLL_SECONDS=60
# Prospective CONTROL/CHALLENGER observation only; no live rule mutation
MARKET_OS_SHADOW_LAB_ENABLED=1

# Kiwoom 0B realtime — observation only, disabled until live preflight is ready
KIWOOM_REALTIME_ENABLED=0
KIWOOM_REALTIME_TOP_N=30
KIWOOM_REALTIME_UNIVERSE_SECONDS=30
KIWOOM_REALTIME_FLUSH_SECONDS=2

# Paper Trading Lab — prospective rule validation only; no orders
PAPER_TRADE_POLL_SECONDS=30
PAPER_ENTRY_SCORE=70
PAPER_ENTRY_SURVIVE_SECONDS=120
PAPER_EXIT_SCORE=55
PAPER_MAX_HOLD_MINUTES=30
PAPER_MAX_OPEN=5
PAPER_QUOTE_FRESH_SECONDS=120

# Paper Lab automatic feedback — analysis only, never auto-applies thresholds
PAPER_FEEDBACK_POLL_SECONDS=60
PAPER_FEEDBACK_LOOKBACK_DAYS=30
PAPER_FEEDBACK_MIN_TYPE_SAMPLES=20
PAPER_FEEDBACK_MIN_RULE_SAMPLES=30
