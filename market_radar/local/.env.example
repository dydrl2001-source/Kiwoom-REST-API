# LOCAL MARKET RADAR
POSTGRES_PASSWORD=change-this-password
DASHBOARD_TOKEN=change-this-long-random-token
MARKET_RADAR_SCHEMA_VERSION=2026.09.29.1

# Kiwoom: first test with demo
KIWOOM_MODE=demo
KIWOOM_POLL_SECONDS=30
KIWOOM_TRADE_VALUE_MULTIPLIER=1000000
KIWOOM_MARKET_CAP_MULTIPLIER=100000000

# Demo keys
APP_KEY_MOCK=
APP_SECRET_MOCK=

# Real keys (use only when KIWOOM_MODE=real)
APP_KEY=
APP_SECRET=

# Telegram API (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BACKFILL_DAYS=7
TELEGRAM_RECONCILE_SECONDS=600

REGIME_POLL_SECONDS=30
REGIME_STALE_SECONDS=120

# Chart / Mimosa
CHART_POLL_SECONDS=60
CHART_TOP_STOCKS=20
CHART_MINUTE_INTERVAL=3
CHART_DAILY_REFRESH_SECONDS=1800
MIMOSA_POLL_SECONDS=30
MIMOSA_INTERVAL_MIN=3

# External news fallback
NEWS_POLL_SECONDS=60
NEWS_REFRESH_MINUTES=15
NEWS_TOP_STOCKS=20

# KOSPI/KOSDAQ index charts
INDEX_CHART_POLL_SECONDS=60
INDEX_CHART_INTERVAL_MIN=5
INDEX_DAILY_REFRESH_SECONDS=1800

# Trigger-driven research queue
RESEARCH_POLL_SECONDS=30
RESEARCH_MIN_SCORE=40
RESEARCH_COOLDOWN_MINUTES=15

# OpenDART (optional but recommended)
DART_API_KEY=
DART_POLL_SECONDS=60
DART_CORP_MAP_REFRESH_HOURS=24

# Local multi-agent deep research
DEEP_RESEARCH_POLL_SECONDS=20
DEEP_RESEARCH_MIN_PRIORITY=60
DEEP_RESEARCH_LOOKBACK_HOURS=24

# Kiwoom market-theme mapping
THEME_POLL_SECONDS=60
THEME_STOCKS_PER_CYCLE=5
THEME_REFRESH_HOURS=24

# External web research (paid API, disabled by default)
OPENAI_API_KEY=
WEB_RESEARCH_MODEL=
WEB_RESEARCH_ENABLED=0
WEB_RESEARCH_AUTO=0
WEB_RESEARCH_DAILY_LIMIT=1
WEB_RESEARCH_HOURLY_LIMIT=1
WEB_RESEARCH_COOLDOWN_MINUTES=60
WEB_RESEARCH_MAX_TOOL_CALLS=3
WEB_RESEARCH_MAX_OUTPUT_TOKENS=3000

# Candidate survival history
CANDIDATE_TRACK_POLL_SECONDS=30

# Home dashboard performance
DASHBOARD_CACHE_SECONDS=20
LEADER_CALENDAR_CACHE_SECONDS=300

# Paper Trading Lab — prospective rule validation only; no orders
PAPER_TRADE_POLL_SECONDS=30
PAPER_ENTRY_SCORE=70
PAPER_ENTRY_SURVIVE_SECONDS=120
PAPER_EXIT_SCORE=55
PAPER_MAX_HOLD_MINUTES=30
PAPER_MAX_OPEN=5
PAPER_QUOTE_FRESH_SECONDS=120
PAPER_REQUIRE_AI_BROKERAGE=1
PAPER_AI_DECISION_FRESH_SECONDS=180

# AI Brokerage decision persistence — paper-only, no broker orders
AI_BROKERAGE_POLL_SECONDS=30

# Official Kiwoom ka10004 order-book collector — read-only
ORDERBOOK_POLL_SECONDS=15
ORDERBOOK_MAX_CODES=15
ORDERBOOK_TARGET_LOOKBACK_MINUTES=20
ORDERBOOK_VENUE_SUFFIX=_AL

# Shadow execution simulator — simulation only, no broker orders.
# Set actual broker/account costs explicitly if you want net-return estimates.
SHADOW_EXECUTION_POLL_SECONDS=30
SHADOW_ACCOUNT_EQUITY_KRW=100000000
SHADOW_RISK_PER_TRADE_PCT=0.5
SHADOW_MAX_POSITION_PCT=10
SHADOW_MAX_PARTICIPATION_PCT=2
SHADOW_COMMISSION_BPS=0
SHADOW_SELL_TAX_BPS=0
SHADOW_MAX_REPLAY_MINUTES=5
SHADOW_ALLOW_PROXY_FALLBACK=1
SHADOW_BOOK_MAX_AGE_SECONDS=30
SHADOW_BOOK_LIQUIDITY_HAIRCUT=0.5
SHADOW_BOOK_MAX_SPREAD_BPS=120
SHADOW_BOOK_CAPACITY_MAX_IS_BPS=30
SHADOW_PORTFOLIO_MAX_TOTAL_RISK_PCT=2.0
SHADOW_PORTFOLIO_MAX_THEME_RISK_PCT=0.8
SHADOW_PORTFOLIO_MAX_FAMILY_RISK_PCT=1.2
SHADOW_PORTFOLIO_MAX_OPEN=5

# Capital Allocation Optimizer — shadow proposals only
ALLOCATION_RISK_CHUNK_PCT=0.05
ALLOCATION_CORRELATION_PENALTY=0.65
ALLOCATION_UNKNOWN_CORRELATION_PENALTY=0.15
ALLOCATION_HIGH_CORRELATION=0.80
ALLOCATION_CORRELATION_MIN_OBS=20
ALLOCATION_PENDING_SCALE=0.35
ALLOCATION_SAMPLE_SCALE=0.20
ALLOCATION_SNAPSHOT_SECONDS=60

# Operational Risk Control — Shadow only; no live order path
RISK_CONTROL_POLL_SECONDS=30
RISK_CONTROL_REQUIRED=1
RISK_CONTROL_STATUS_MAX_AGE_SECONDS=120
RISK_MANUAL_HALT=0
RISK_RECOVERY_HEALTHY_STREAK=3
RISK_RECOVERY_REQUIRE_ACK=1
RESILIENCE_AUDIT_SECONDS=300
RISK_MAX_DAILY_LOSS_PCT=2.0
RISK_HARD_UTILIZATION_PCT=105
RISK_WARN_UTILIZATION_PCT=90
RISK_CRITICAL_FEED_MAX_AGE_SECONDS=180
RISK_ORDERBOOK_MAX_AGE_SECONDS=90
RISK_MAX_MEDIAN_IS_BPS=60
RISK_WARN_MEDIAN_IS_BPS=40
RISK_MAX_EXECUTION_REJECT_PCT=50
RISK_WARN_EXECUTION_REJECT_PCT=30
RISK_MIN_BOOK_COVERAGE_PCT=50
RISK_MAX_PORTFOLIO_CORR=0.92
RISK_WARN_PORTFOLIO_CORR=0.80
RISK_MAX_UNKNOWN_CORR_PAIRS=3

# Rebalance proposals — advisory only
REBALANCE_WATCH_REDUCE_FRACTION=0.50
REBALANCE_HIGH_CORR_REDUCE_FRACTION=0.25
REBALANCE_HIGH_CORR_THRESHOLD=0.90
REBALANCE_REPLACEMENT_PRIORITY_GAP=0.15

# Live Readiness checklist — does not enable live trading
LIVE_READINESS_MIN_PAPER_CLOSED=100
LIVE_READINESS_MIN_SHADOW_CLOSED=60
LIVE_READINESS_MIN_BOOK_CLOSED=40
LIVE_READINESS_MIN_OPERATING_DAYS=10
LIVE_READINESS_MIN_BOOK_COVERAGE_PCT=80
LIVE_READINESS_MIN_SUPPORTED_STRATEGIES=1
LIVE_READINESS_COSTS_CONFIRMED=0

# Paper Lab automatic feedback — analysis only, never auto-applies thresholds
PAPER_FEEDBACK_POLL_SECONDS=60
PAPER_FEEDBACK_LOOKBACK_DAYS=30
PAPER_FEEDBACK_MIN_TYPE_SAMPLES=20
PAPER_FEEDBACK_MIN_RULE_SAMPLES=30
